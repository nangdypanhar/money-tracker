# Optional encrypted cloud backup (Supabase). Copy to .env and fill in. Without these, cloud backup is hidden
# behind "not set up" and the app stays local-only.
# Use the project URL and the PUBLISHABLE (anon) key — never the service-role / secret key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: domain for the login emails derived from recovery keys (no mail is ever sent).
# NEXT_PUBLIC_BACKUP_EMAIL_DOMAIN=backup.moneytrack.invalid
